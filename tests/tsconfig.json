{
  "extends": "../tsconfig.json",
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../packages/**/src/**/*.test.ts",
    "../packages/**/src/**/*.test.tsx",
    "../packages/*/tests/**/*.ts",
    "../packages/*/tests/**/*.tsx",
    "../packages/react/src/**/*.stories.tsx",
    "../packages/react/src/css.d.ts",
    "../apps/*/components/**/*.test.tsx",
    "../apps/*/lib/**/*.test.ts",
    "../apps/*/tests/**/*.test.tsx",
    "../examples/consumer/src/**/*.test.ts",
    "../examples/consumer/src/**/*.test.tsx",
    "../examples/*/host.test.ts",
    "../examples/*/host.test.tsx",
    "../.storybook/**/*.ts",
    "../.storybook/**/*.tsx"
  ],
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": {
      "@ai-interaction/core/uploads": ["../packages/core/src/uploads.ts"],
      "@ai-interaction/react/upload": ["../packages/react/src/upload-attachment.tsx"],
      "@ai-interaction/core": ["../packages/core/src/index.ts"],
      "@ai-interaction/core/schema": ["../packages/core/src/schema.ts"],
      "@ai-interaction/react": ["../packages/react/src/index.ts"],
      "@ai-interaction/react/theme": ["../packages/react/src/theme.ts"],
      "@ai-interaction/react/markdown": ["../packages/react/src/markdown.tsx"],
      "@ai-interaction/react/rich-markdown": ["../packages/react/src/rich-markdown.tsx"],
      "@ai-interaction/react/math": ["../packages/react/src/math.tsx"],
      "@ai-interaction/react/mermaid": ["../packages/react/src/mermaid.tsx"],
      "@ai-interaction/react/code": ["../packages/react/src/code.ts"],
      "@ai-interaction/react/highlight": ["../packages/react/src/highlight.tsx"],
      "@ai-interaction/core/conversation": ["../packages/core/src/conversation-validation.ts"],
      "@ai-interaction/core/history": ["../packages/core/src/history.ts"],
      "@ai-interaction/core/adapter": ["../packages/core/src/adapter.ts"],
      "@ai-interaction/react/viewport": ["../packages/react/src/viewport.tsx"],
      "@ai-interaction/react/layout": ["../packages/react/src/layout.ts"],
      "@ai-interaction/react/sidecar": ["../packages/react/src/sidecar.tsx"],
      "@ai-interaction/react/workspace": ["../packages/react/src/workspace-shell.tsx"]
    }
  }
}
