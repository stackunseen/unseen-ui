{
  "name": "@stackunseen/ui-core",
  "version": "0.1.0-alpha.0",
  "description": "Framework-independent contracts, schemas and state projection for AI interfaces. Part of Unseen UI.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "chat",
    "schema",
    "approvals",
    "tool-calls",
    "unseen-ui"
  ],
  "author": "Stack Unseen",
  "private": false,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./conversation": {
      "types": "./dist/conversation-validation.d.ts",
      "import": "./dist/conversation.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./uploads": {
      "types": "./dist/uploads.d.ts",
      "import": "./dist/uploads.js"
    },
    "./editing": {
      "types": "./dist/editing.d.ts",
      "import": "./dist/editing.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackunseen/unseen-ui.git",
    "directory": "packages/core"
  }
}
