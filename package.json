{
  "name": "unseen-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @unseen-ui/docs dev",
    "preview": "node scripts/serve-docs.mjs",
    "template:dev": "pnpm --filter @unseen-ui/consumer exec vite --host 127.0.0.1 --port 4184 --strictPort",
    "template:preview": "pnpm --filter @unseen-ui/consumer exec vite preview --host 127.0.0.1 --port 4184 --strictPort",
    "files:demo": "node examples/file-host/serve.mjs",
    "terminal:demo": "node examples/pty-host/demo.mjs",
    "terminal:serve": "node examples/pty-host/serve.mjs",
    "build:packages": "pnpm --filter @stackunseen/ui-core build && pnpm --filter @stackunseen/ui build",
    "build": "pnpm build:packages && pnpm --filter @unseen-ui/docs build && pnpm --filter @unseen-ui/consumer build",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint packages apps examples tests && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:release": "node --test scripts/release.test.mjs",
    "release:plan": "node scripts/release.mjs plan",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:pack": "node scripts/release.mjs pack",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:template": "node scripts/template-browser.mjs",
    "format": "prettier --write packages apps examples tests scripts *.json *.ts *.mjs",
    "format:check": "prettier --check packages apps examples tests scripts *.json *.ts *.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:size": "node scripts/check-size.mjs",
    "manifest": "node scripts/component-manifest.mjs",
    "check:manifest": "node scripts/component-manifest.mjs --check",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --output-dir output/storybook",
    "uploads:serve": "node examples/upload-host/serve.mjs",
    "uploads:demo": "node examples/upload-host/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/cli": "0.1.21",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/culori": "4.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "katex": "0.18.9",
    "node-pty": "1.1.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.3.1",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
